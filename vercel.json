{
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "framework": null,
  "crons": [
    {
      "path": "/api/public/cron/claim-reminder",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}